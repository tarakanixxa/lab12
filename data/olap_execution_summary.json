    "name": "05_pivot_shift",
    "sql": "\nPIVOT (SELECT s.shift_name, SUM(f.quantity_good) AS good_units\n       FROM fact_production f JOIN dim_shift s USING(shift_key)\n       GROUP BY s.shift_name)\nON shift_name IN ('Ранкова','Вечірня','Нічна') USING SUM(good_units)\n",
